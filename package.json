{
  "name": "tamerlane-chess",
  "private": true,
  "description": "Full Tamerlane Chess. The site itself needs no build; this file only holds the test tools.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,auth --project demo-tamerlane \"node --test --test-concurrency=1 tests/*.test.mjs\"",
    "test:engine": "node --test tests/engine.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.33.0",
    "playwright": "1.62.1"
  }
}
